{
  "name": "@ai-visibility/core",
  "version": "0.0.0",
  "description": "Runtime-agnostic AI-visibility engine. No Node built-ins; fetch only; keys passed as args.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  }
}
